<?xml version="1.0" encoding="utf-8"?>
<!-- Una opinión escrita sobre una ruta, en la ficha del micro. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="12dp">

    <TextView
        android:id="@+id/reviewHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Expresdm.Body"
        android:textSize="12sp"
        tools:text="★★★★☆ · Ana María" />

    <TextView
        android:id="@+id/reviewComment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:textColor="?attr/colorOnSurface"
        android:textSize="14sp"
        tools:text="Limpio y el cobrador amable, pero demora en hora punta." />
</LinearLayout>
