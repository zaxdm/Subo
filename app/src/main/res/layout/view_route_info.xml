<?xml version="1.0" encoding="utf-8"?>
<!--
  La ficha de un micro: su foto, cuándo pasa, cuánto cuesta y lo que la gente
  dice de él. Va en el panel de la ruta elegida en el mapa y en la pantalla
  propia de la ficha; la rellena RouteInfoPanel.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- La foto del micro; sin foto, su color con la letra de fondo -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/detailImageCard"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="22dp"
        app:strokeWidth="0dp"
        tools:cardBackgroundColor="@color/route_accent_1">

        <TextView
            android:id="@+id/detailWatermark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:alpha="0.25"
            android:importantForAccessibility="no"
            android:textColor="@color/white"
            android:textSize="120sp"
            android:textStyle="bold"
            tools:text="B" />

        <ImageView
            android:id="@+id/detailImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Nombre de la empresa o del micro, y lo que el catálogo diga de él -->
    <TextView
        android:id="@+id/detailDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textAppearance="@style/TextAppearance.Expresdm.Body"
        android:visibility="gone"
        tools:text="Empresa California S.A."
        tools:visibility="visible" />

    <!-- Horario y duración -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            app:cardBackgroundColor="?attr/colorPrimaryContainer"
            app:cardCornerRadius="18dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/route_schedule"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/detailSchedule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="2dp"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="05:30 – 22:00" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            app:cardBackgroundColor="?attr/colorPrimaryContainer"
            app:cardCornerRadius="18dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/route_detail_trip"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/detailDuration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="2dp"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="38 min" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Cada cuánto pasa, cuando el catálogo lo sabe -->
    <TextView
        android:id="@+id/detailFrequency"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:textColor="?attr/colorOnSurface"
        android:textSize="15sp"
        android:visibility="gone"
        app:drawableStartCompat="@drawable/ic_clock"
        app:drawableTint="?attr/colorOnSurfaceVariant"
        tools:text="Pasa cada 10 min"
        tools:visibility="visible" />

    <!-- Lo que se reportó de este micro en la última semana -->
    <TextView
        android:id="@+id/detailAlertsWeek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:textColor="@color/alert_accident"
        android:textSize="14sp"
        android:visibility="gone"
        app:drawableStartCompat="@drawable/ic_alert_danger"
        app:drawableTint="@color/alert_accident"
        tools:text="Esta semana: 3 reportes de cobro de más"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShare"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/route_detail_share"
            app:icon="@drawable/ic_send"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveOffline"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/route_detail_save"
            app:icon="@drawable/ic_map"
            app:iconGravity="textStart" />
    </LinearLayout>

    <TextView
        android:id="@+id/saveOfflineNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textAppearance="@style/TextAppearance.Expresdm.Body"
        android:textSize="12sp"
        tools:text="2 de 5 rutas guardadas sin conexión" />

    <!-- Tarifas -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/route_detail_fares"
        android:textAppearance="@style/TextAppearance.Expresdm.SectionTitle"
        android:textSize="17sp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:cardCornerRadius="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/rowFareSchool"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/route_detail_fare_school"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/fareSchool"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="S/ 0.50" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowFareUniversity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/route_detail_fare_university"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/fareUniversity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="S/ 1.00" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/route_detail_fare_regular"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/fareRegular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="S/ 2.00" />
            </LinearLayout>

            <TextView
                android:id="@+id/faresNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:text="@string/route_detail_fares_note"
                android:textAppearance="@style/TextAppearance.Expresdm.Body"
                android:textSize="12sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Calificaciones: solo con servidor, que es donde viven -->
    <LinearLayout
        android:id="@+id/communitySection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/route_detail_ratings"
            android:textAppearance="@style/TextAppearance.Expresdm.SectionTitle"
            android:textSize="17sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/ratingSummary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="★ 4.3 · 12 calificaciones" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRate"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/route_detail_rate" />
                </LinearLayout>

                <!-- Las últimas opiniones escritas; las pone RouteInfoPanel. -->
                <LinearLayout
                    android:id="@+id/reviewsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</LinearLayout>
