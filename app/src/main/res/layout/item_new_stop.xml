<?xml version="1.0" encoding="utf-8"?>
<!-- Una parada detectada en la grabación, con su nombre editable. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/stopNumber"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_circle_badge"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="1" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/stopNameLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:hint="@string/new_route_stop_name">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/stopNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="textCapWords"
            android:maxLength="40"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <ImageButton
        android:id="@+id/btnRemoveStop"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/new_route_remove_stop"
        android:src="@drawable/ic_delete"
        app:tint="?attr/colorOnSurfaceVariant" />
</LinearLayout>
