<?xml version="1.0" encoding="utf-8"?>
<!-- Una sugerencia que mandó el usuario, con su estado y la respuesta si la hay. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    app:cardCornerRadius="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/feedbackHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Expresdm.Body"
            android:textSize="12sp"
            tools:text="Rutas · Resuelta" />

        <TextView
            android:id="@+id/feedbackMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            tools:text="Falta la ruta a Moche" />

        <TextView
            android:id="@+id/feedbackReply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_search_field"
            android:backgroundTint="?attr/colorPrimaryContainer"
            android:padding="12dp"
            android:textColor="?attr/colorOnPrimaryContainer"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="Respuesta: ya la agregamos, gracias."
            tools:visibility="visible" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
