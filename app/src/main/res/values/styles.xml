<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tarjetas: superficie plana con borde fino, como en el diseño -->
    <style name="Widget.Expresdm.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
    </style>

    <style name="Widget.Expresdm.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/brand</item>
        <item name="tint">@color/on_brand</item>
    </style>

    <style name="Widget.Expresdm.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">?attr/colorSurface</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Expresdm.NavIndicator</item>
        <item name="itemIconTint">@color/bottom_nav_icon</item>
        <item name="itemTextColor">@color/bottom_nav_item</item>
    </style>

    <!-- La pestaña activa: una pastilla del amarillo de marca -->
    <style name="Widget.Expresdm.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/brand</item>
    </style>

    <!-- Tipografía -->
    <style name="TextAppearance.Expresdm.SectionLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Expresdm.SectionTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Expresdm.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Insignia circular con la letra de la ruta -->
    <style name="Widget.Expresdm.RouteBadge" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Opción de una lista de ajustes -->
    <style name="Widget.Expresdm.Choice" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Casilla de una lista de ajustes -->
    <style name="Widget.Expresdm.Check" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Cuadro de color de la muestra de paleta -->
    <style name="Widget.Expresdm.Swatch" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:background">@drawable/bg_swatch</item>
    </style>

    <!--
      Botón principal: una pastilla. De día es negra con el texto blanco, como
      en la web; de noche, amarilla con el texto negro (colorPrimary cambia).
    -->
    <style name="Widget.Expresdm.ButtonPrimary" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">26dp</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="iconTint">?attr/colorOnPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Acciones del destino elegido, en fila sobre la lista de formas de llegar -->
    <style name="Widget.Expresdm.PlaceAction" parent="Widget.Material3.Button.OutlinedButton.Icon">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textSize">13sp</item>
        <item name="iconSize">18dp</item>
    </style>

    <!-- La primera de la fila, rellena: es la que más se usa -->
    <style name="Widget.Expresdm.PlaceAction.Tonal" parent="Widget.Material3.Button.TonalButton.Icon">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textSize">13sp</item>
        <item name="iconSize">18dp</item>
    </style>

</resources>
