<?xml version="1.0" encoding="utf-8"?>
<!-- Oscurece la tarjeta de una ruta de abajo hacia arriba, para que el texto
     blanco se lea encima de cualquier foto o color. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="90"
        android:centerColor="#730B0E13"
        android:centerY="0.55"
        android:endColor="#260B0E13"
        android:startColor="#E60B0E13" />
</shape>
