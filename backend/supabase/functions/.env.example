# Plantilla: copia este archivo como .env en esta misma carpeta
# (backend/supabase/functions/.env). Ese archivo NO se sube a git.
#
# En local lo lee `supabase functions serve`; en la nube se sube con:
#   supabase secrets set --env-file supabase/functions/.env
#
# SUPABASE_DB_URL no va aquí: Supabase se lo da a la función automáticamente.

# Firma de los tokens de sesión. Cualquier texto largo y difícil de adivinar.
# Si es el mismo que usaba el servidor Ktor, las sesiones abiertas siguen valiendo.
# Si cambia, todos los usuarios tienen que volver a iniciar sesión.
JWT_SECRET=pon_aqui_un_secreto_largo

# IDs OAuth de tipo Web aceptados para el acceso con Google, separados por coma.
# Debe incluir el GOOGLE_WEB_CLIENT_ID de Android. Vacío: Google desactivado.
GOOGLE_WEB_CLIENT_IDS=

# Clave de Gemini: https://aistudio.google.com/apikey
# Sin ella el asistente queda desactivado y la moderación deja pasar los textos.
GEMINI_API_KEY=pon_aqui_tu_clave

# Modelo de Gemini (opcional).
# GEMINI_MODEL=gemini-3.5-flash-lite
