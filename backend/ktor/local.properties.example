## Plantilla: copia este archivo como local.properties dentro de backend/.
## backend/local.properties NO se sube a git: aquí viven las claves del servidor.

# Base de datos (PostgreSQL). Con el PostgreSQL portable de scripts/postgres.ps1:
DB_URL=jdbc:postgresql://localhost:5432/expresdm
DB_USER=expresdm
DB_PASSWORD=pon_aqui_tu_clave

# Firma de los tokens de sesión. Cualquier texto largo y difícil de adivinar.
# Si cambia, todos los usuarios tienen que volver a iniciar sesión.
JWT_SECRET=pon_aqui_un_secreto_largo

# Clave de Gemini: aquí, en el servidor, en lugar de dentro de la APK.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=pon_aqui_tu_clave

# Puerto en el que escucha el servidor.
PORT=8080
